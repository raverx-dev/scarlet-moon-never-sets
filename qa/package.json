{
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "python3 build.py",
    "dev": "node server.cjs",
    "agent": "node agent-run.mjs",
    "agent:headed": "node agent-run.mjs --headed",
    "agent:no-captures": "node agent-run.mjs --no-captures",
    "service": "node service/server.mjs",
    "service:test": "node --test service/*.test.mjs",
    "service:smoke": "node service/smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
